<mxfile host="app.diagrams.net"><diagram name="VLAN and Zone View" id="zone1"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z2" value="VLAN and Zone View" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="600" height="32" as="geometry"/></mxCell><mxCell id="z3" value="Logical view of the same network: what lives in each zone and how zones connect. Allowed flows: docs/security.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="21" as="geometry"/></mxCell><mxCell id="z4" value="&lt;b style=&quot;font-size:12px&quot;&gt;Internet (3 ISPs)&lt;/b&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="650.0" y="85.0" width="150" height="50" as="geometry"/></mxCell><mxCell id="z5" value="&lt;b style=&quot;font-size:12px&quot;&gt;Firewall HA pair (FW-A / FW-B)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;VLAN 2 transit 10.20.0.0/29 | NAT | IPS | VPN&lt;br&gt;if-wan1..3 | if-dmz | if-cctv | if-lan 10G x2&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="515.0" y="178.0" width="420" height="74" as="geometry"/></mxCell><mxCell id="z6" value="&lt;b style=&quot;font-size:12px&quot;&gt;DMZ: VLAN 200&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.200.0/24 (dedicated 2.5G port)&lt;br&gt;Web server; mail hosted or pinned to WAN 1&lt;br&gt;Inbound 80/443 only; DMZ cannot reach internal&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="70.0" y="169.0" width="280" height="92" as="geometry"/></mxCell><mxCell id="z7" value="&lt;b style=&quot;font-size:12px&quot;&gt;CCTV: VLAN 70&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.70.0/24, gateway on firewall&lt;br&gt;28 cameras + NVR (floor switches / DS)&lt;br&gt;Deny-all inbound | NTP only | VPN-only viewing&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1095.0" y="169.0" width="290" height="92" as="geometry"/></mxCell><mxCell id="z8" value="&lt;b style=&quot;font-size:12px&quot;&gt;Distribution stack DS-1 + DS-2 (Layer 3)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;Inter-VLAN routing | stateless ACLs | DHCP | every floor, server block and firewall dual-homed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="75.0" y="335.0" width="1300" height="70" as="geometry"/></mxCell><mxCell id="z9" value="&lt;b style=&quot;font-size:12px&quot;&gt;Management: VLAN 10&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.10.0/24&lt;br&gt;Jump host, NMS, NTP, AP controller&lt;br&gt;Only admin path to devices and ACS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="27.5" y="525.0" width="205" height="130" as="geometry"/></mxCell><mxCell id="z10" value="&lt;b style=&quot;font-size:12px&quot;&gt;Enterprise servers: VLAN 25&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.25.0/24&lt;br&gt;2x DC, file, print, RADIUS/NPS&lt;br&gt;Reached by enterprise users only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0e7490;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="257.5" y="525.0" width="205" height="130" as="geometry"/></mxCell><mxCell id="z11" value="&lt;b style=&quot;font-size:12px&quot;&gt;Enterprise users: 20, 30, 50&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.20/30/50.0/24&lt;br&gt;Wired, printers, 802.1X Wi-Fi (floors 1-2)&lt;br&gt;No access to MGMT, ACS, CCTV, residence&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0e7490;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="487.5" y="525.0" width="205" height="130" as="geometry"/></mxCell><mxCell id="z12" value="&lt;b style=&quot;font-size:12px&quot;&gt;Guest: VLAN 60&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.60.0/24&lt;br&gt;Lobby and common-area Wi-Fi&lt;br&gt;Internet only, rate-limited&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#a16207;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="717.5" y="525.0" width="205" height="130" as="geometry"/></mxCell><mxCell id="z13" value="&lt;b style=&quot;font-size:12px&quot;&gt;Residence: VLAN 103-108&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.103-108.0/24&lt;br&gt;One VLAN per floor (floors 3-8)&lt;br&gt;Internet + DMZ web only; no floor-to-floor&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="947.5" y="525.0" width="205" height="130" as="geometry"/></mxCell><mxCell id="z14" value="&lt;b style=&quot;font-size:12px&quot;&gt;Building systems: VLAN 40, 41&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.40.0/24, 10.20.41.0/24&lt;br&gt;Door + elevator controllers, ACS server&lt;br&gt;NOT routed; admin only via jump host&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1177.5" y="525.0" width="205" height="130" as="geometry"/></mxCell><mxCell id="z15" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#64748b;strokeWidth=2.2;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z4" target="z5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z16" value="3 bridge-mode modems" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="663.0" y="149" width="132.0" height="16" as="geometry"/></mxCell><mxCell id="z17" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#c2410c;strokeWidth=2.4;exitX=0.000;exitY=0.500;entryX=1.000;entryY=0.500;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z5" target="z6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z18" value="2.5G" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="419.6" y="199" width="32.8" height="16" as="geometry"/></mxCell><mxCell id="z19" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#b91c1c;strokeWidth=2.4;exitX=1.000;exitY=0.500;entryX=0.000;entryY=0.500;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z5" target="z7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z20" value="VLAN 70 via DS trunk" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#b91c1c;" vertex="1" parent="1"><mxGeometry x="953.0" y="199" width="132.0" height="16" as="geometry"/></mxCell><mxCell id="z21" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#1d4ed8;strokeWidth=4.5;exitX=0.500;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z5" target="z8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z22" value="10G x2 | VLAN 2, 70" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="666.1" y="286" width="125.8" height="16" as="geometry"/></mxCell><mxCell id="z23" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#0f766e;strokeWidth=2.2;exitX=0.042;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z8" target="z9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z24" value="VLAN 10" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#0f766e;" vertex="1" parent="1"><mxGeometry x="108.3" y="457" width="51.4" height="16" as="geometry"/></mxCell><mxCell id="z25" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#0e7490;strokeWidth=2.4;exitX=0.219;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z8" target="z10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z26" value="VLAN 25" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#0e7490;" vertex="1" parent="1"><mxGeometry x="338.3" y="457" width="51.4" height="16" as="geometry"/></mxCell><mxCell id="z27" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#0e7490;strokeWidth=2.4;exitX=0.396;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z8" target="z11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z28" value="VLAN 20/30/50" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#0e7490;" vertex="1" parent="1"><mxGeometry x="549.7" y="457" width="88.60000000000001" height="16" as="geometry"/></mxCell><mxCell id="z29" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#a16207;strokeWidth=2.2;exitX=0.573;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z8" target="z12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z30" value="VLAN 60" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#a16207;" vertex="1" parent="1"><mxGeometry x="798.3" y="457" width="51.4" height="16" as="geometry"/></mxCell><mxCell id="z31" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#15803d;strokeWidth=2.4;exitX=0.750;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z8" target="z13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z32" value="VLAN 103-108" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="1012.8" y="457" width="82.4" height="16" as="geometry"/></mxCell><mxCell id="z33" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#6d28d9;strokeWidth=2.2;dashed=1;dashPattern=7 4;exitX=0.927;exitY=1.000;entryX=0.500;entryY=0.000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="z8" target="z14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z34" value="L2 only (40/41)" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontStyle=1;fontColor=#6d28d9;" vertex="1" parent="1"><mxGeometry x="1233.5" y="457" width="101.0" height="16" as="geometry"/></mxCell><mxCell id="z35" value="Reading this view" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="300" height="23" as="geometry"/></mxCell><mxCell id="z36" value="Solid lines are routed or physical links; the dashed purple line means the VLANs are bridged only and never routed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="716" width="1350" height="21" as="geometry"/></mxCell><mxCell id="z37" value="The firewall is the gateway for VLAN 70 (CCTV) and VLAN 200 (DMZ); the distribution stack routes every other VLAN." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="738" width="1350" height="21" as="geometry"/></mxCell><mxCell id="z38" value="Residence floors never see each other: one VLAN per floor, protected ports, client isolation on Wi-Fi." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1350" height="21" as="geometry"/></mxCell><mxCell id="z39" value="Zone colors: blue = core/edge, orange = DMZ, red = CCTV, purple = building systems, green = residence, cyan = enterprise, teal = management, yellow = guest." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=0;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="782" width="1350" height="21" as="geometry"/></mxCell><mxCell id="z40" value="Rev 2.0  |  2026-11-22  |  Status: DRAFT for review" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="420" height="21" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>