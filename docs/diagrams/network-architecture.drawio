<mxfile host="app.diagrams.net"><diagram name="Network Architecture" id="net1"><mxGraphModel dx="1700" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1264" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;DMZ (VLAN 200)&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;spacingBottom=6;fontSize=13;fontColor=#c2410c;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="208" width="300" height="132" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Enterprise floors 1-2: AD domain network&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;Locked, tamper-alarmed cabinets | port security&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;fillColor=#ecfeff;strokeColor=#0e7490;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=14;spacingTop=4;spacingBottom=6;fontSize=13;fontColor=#0e7490;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="410" height="460" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Residence floors 3-8: one VLAN per floor (103-108)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#475569&quot;&gt;Cabinets locked, ventilated, tamper-alarmed | port security | unused ports off | DHCP snooping + client isolation&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=14;spacingTop=4;spacingBottom=6;fontSize=13;fontColor=#15803d;html=1;" vertex="1" parent="1"><mxGeometry x="452" y="650" width="1206" height="460" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;ISP 1&lt;/b&gt;" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeC