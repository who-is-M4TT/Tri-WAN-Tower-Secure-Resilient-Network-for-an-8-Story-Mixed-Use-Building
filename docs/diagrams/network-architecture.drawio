x="1055.0" y="155.0" width="170" height="46" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Firewall HA pair: FW-A (active) + FW-B (standby)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10G | IPS + VPN | VRRP/CARP VIP | state-sync link | 3-WAN failover + load balancing&lt;br&gt;if-wan1..3 | if-dmz (VLAN 200) | if-cctv (VLAN 70) | if-lan 10G x2&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="530.0" y="238.0" width="640" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Web Server (DMZ)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;10.20.200.10 | mail hosted / WAN 1 only&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#c2410c;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="80.0" y="256.0" width="220" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Remote-access VPN (MFA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;admin + vendor sessions land on&lt;br&gt;the jump host (VLAN 10) only&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1360.0" y="241.0" width="300" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Management (VLAN 10)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;jump host | NMS | syslog | NTP&lt;br&gt;config backup | AP controller | DNS&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40.5" y="359.0" width="255" height="74" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Enterprise servers (VLAN 25)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;2x DC | file | print | RADIUS/NPS&lt;br&gt;roles separated, dual-homed 10G&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0e7490;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="304.5" y="359.0" width="255" height="74" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;UPS + generator (ATS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;core, firewalls, floor switches and PoE&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="660.0" y="367.0" width="380" height="58" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;ACS servers (VLAN 40/41)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;access-control + elevator servers&lt;br&gt;admin only via jump host&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1135.5" y="359.0" width="255" height="74" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;NVR + monitoring (VLAN 70)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#334155&quot;&gt;logically isolated | deny-all inbound&lt;br&gt;NTP only | VPN-only remote view&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=1.6;fontColor=#0f172a;" vertex="1" parent="